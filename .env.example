# Database
DATABASE_URL=sqlite:///./data/privatemind.db

# Inference Mode: demo, ollama, or openai
INFERENCE_MODE=demo

# Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI (optional, for remote inference)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Embedding Model
EMBEDDING_MODEL=all-minilm-l6-v2

# Application
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=50
